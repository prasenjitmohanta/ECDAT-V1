/* ================================================================
   ecdat_light.qss  —  ECDAT Light Mode (Clean & Functional)
   ────────────────────────────────────────────────────────────
   Palette:
     Canvas Base:      #F0F2F5 (Clean Neutral Grey)
     Card Surface:     #FFFFFF (Pure White)
     Border Line:      #CBD5E1 (Crisp Light Border)
     Primary Blue:     #3182CE (Codeforces Brand Blue)
     Critical Red:     #EF4444
     Warning Amber:    #F59E0B
     Safe Green:       #10B981
     Text Primary:     #1E293B
     Text Secondary:   #64748B
   ================================================================ */

* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, "SF Pro Text", sans-serif;
    font-size: 12px;
}

QWidget {
    background-color: #F0F2F5;
    color: #1E293B;
}

QMainWindow {
    background-color: #F0F2F5;
}

/* ── Menu Bar ──────────────────────────────────────────────── */
QMenuBar {
    background-color: #FFFFFF;
    color: #334155;
    border-bottom: 1px solid #CBD5E1;
    padding: 3px 10px;
    font-size: 12px;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 3px;
}
QMenuBar::item:selected {
    background-color: #E2E8F0;
    color: #0F172A;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 20px;
    border-radius: 3px;
    color: #1E293B;
}
QMenu::item:selected {
    background-color: #3182CE;
    color: #FFFFFF;
}
QMenu::separator {
    height: 1px;
    background-color: #E2E8F0;
    margin: 4px 6px;
}

/* ── Top Header Bar ────────────────────────────────────────── */
#headerBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #CBD5E1;
}

#brandLogo {
    background: transparent;
}

/* ── Navigation Tabs ───────────────────────────────────────── */
#navGroup {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
}

#navPill {
    background: transparent;
    color: #475569;
    border: none;
    border-radius: 3px;
    padding: 6px 14px;
    font-weight: 700;
    font-size: 11px;
}
#navPill:hover {
    background-color: #E2E8F0;
    color: #0F172A;
}
#navPill:checked {
    background-color: #3182CE;
    color: #FFFFFF;
    font-weight: 700;
}

/* ── Theme Toggle Button (Sun/Moon) ────────────────────────── */
#btnThemeToggle {
    background-color: #F1F5F9;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    padding: 2px 10px;
}
#btnThemeToggle:hover {
    background-color: #E2E8F0;
    border-color: #94A3B8;
}

#statusReady {
    color: #059669;
    font-weight: 700;
    font-size: 11px;
    background-color: #ECFDF5;
    border: 1px solid #A7F3D0;
    border-radius: 3px;
    padding: 0 10px;
}
#statusScanning {
    color: #D97706;
    font-weight: 700;
    font-size: 11px;
    background-color: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: 3px;
    padding: 0 10px;
}
#statusComplete {
    color: #2563EB;
    font-weight: 700;
    font-size: 11px;
    background-color: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-radius: 3px;
    padding: 0 10px;
}

/* ── Summary Cards ─────────────────────────────────────────── */
#heroCardCrit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-top: 3px solid #EF4444;
    border-radius: 4px;
}
#heroCardMod {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-top: 3px solid #F59E0B;
    border-radius: 4px;
}
#heroCardSafe {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-top: 3px solid #10B981;
    border-radius: 4px;
}
#heroCardTotal {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-top: 3px solid #3182CE;
    border-radius: 4px;
}

#heroCount {
    font-family: Arial, sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: #0F172A;
    background: transparent;
}

/* ── Container Cards ───────────────────────────────────────── */
#slateCard {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
}

#slateCard QLabel {
    background: transparent;
}

#cardHeader {
    font-size: 11px;
    font-weight: 800;
    color: #1E293B;
    letter-spacing: 0.5px;
    background: transparent;
    padding: 0;
}

/* ── Form Inputs ────────────────────────────────────────────── */
QLineEdit {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    padding: 6px 8px;
    font-size: 12px;
    selection-background-color: #3182CE;
    selection-color: #FFFFFF;
}

#targetInput,
#projectInput,
#searchFilterInput {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    padding: 6px 8px;
    font-size: 12px;
}
#targetInput:focus,
#projectInput:focus,
#searchFilterInput:focus,
QLineEdit:focus {
    border: 1px solid #3182CE;
    background-color: #FFFFFF;
}

QLineEdit::placeholder {
    color: #94A3B8;
}

/* ── Checkboxes ─────────────────────────────────────────────── */
QCheckBox {
    color: #334155;
    spacing: 6px;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #94A3B8;
    border-radius: 2px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #3182CE;
}
QCheckBox::indicator:checked {
    background-color: #3182CE;
    border-color: #3182CE;
}

/* ── Action Buttons ─────────────────────────────────────────── */
#btnBrowse {
    background-color: #F1F5F9;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    font-weight: 600;
    font-size: 11px;
}
#btnBrowse:hover {
    background-color: #E2E8F0;
    color: #0F172A;
}

#btnAuditStart {
    background-color: #3182CE;
    color: #FFFFFF;
    border: 1px solid #2B6CB0;
    border-radius: 3px;
    font-size: 12px;
    font-weight: 700;
}
#btnAuditStart:hover {
    background-color: #2B6CB0;
}
#btnAuditStart:disabled {
    background-color: #E2E8F0;
    border-color: #CBD5E1;
    color: #94A3B8;
}

#btnAuditStop {
    background-color: #FEE2E2;
    color: #B91C1C;
    border: 1px solid #FCA5A5;
    border-radius: 3px;
    font-weight: 700;
    font-size: 11px;
}
#btnAuditStop:hover {
    background-color: #FECACA;
}
#btnAuditStop:disabled {
    border-color: #E2E8F0;
    color: #94A3B8;
    background-color: transparent;
}

#btnHeaderExport,
#btnGhostSmall {
    background-color: #F8FAFC;
    color: #334155;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    padding: 4px 12px;
    font-weight: 600;
    font-size: 11px;
}
#btnHeaderExport:hover,
#btnGhostSmall:hover {
    background-color: #E2E8F0;
    color: #0F172A;
}
#btnHeaderExport:disabled {
    color: #94A3B8;
    border-color: #E2E8F0;
    background-color: transparent;
}

/* ── Mosca Sliders ─────────────────────────────────────────── */
QSlider#moscaSlider::groove:horizontal {
    height: 5px;
    background-color: #E2E8F0;
    border-radius: 2px;
}
QSlider#moscaSlider::sub-page:horizontal {
    background-color: #3182CE;
    border-radius: 2px;
}
QSlider#moscaSlider::handle:horizontal {
    background-color: #FFFFFF;
    border: 2px solid #3182CE;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider#moscaSlider::handle:horizontal:hover {
    background-color: #3182CE;
}

/* ── Verdict Labels ────────────────────────────────────────── */
#verdictCrit {
    font-size: 11px;
    font-weight: 800;
    color: #DC2626;
    background: transparent;
}
#verdictWarn {
    font-size: 11px;
    font-weight: 800;
    color: #D97706;
    background: transparent;
}
#verdictSafe {
    font-size: 11px;
    font-weight: 800;
    color: #059669;
    background: transparent;
}

#verdictDesc {
    font-size: 10px;
    color: #475569;
    background: transparent;
}

/* ── CBOM Table View ───────────────────────────────────────── */
#cbomTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    gridline-color: #E2E8F0;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    selection-background-color: #EFF6FF;
    selection-color: #1E293B;
}

#cbomTableView QHeaderView::section {
    background-color: #F1F5F9;
    color: #334155;
    padding: 7px 10px;
    border: none;
    border-right: 1px solid #CBD5E1;
    border-bottom: 1px solid #CBD5E1;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.5px;
}
#cbomTableView QHeaderView::section:hover {
    background-color: #E2E8F0;
}

/* ── Code Snippet Area ─────────────────────────────────────── */
#codeSnippetArea {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1px solid #CBD5E1;
    border-radius: 3px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 11px;
    padding: 6px;
}

/* ── Bottom Terminal Dock & Console Log (Always Dark Hacker Aesthetic) ──────────────── */
#bottomDock,
#logDock {
    background-color: #0F172A;
    border-top: 1px solid #1E293B;
}

#scanProgress {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 3px;
    color: #E2E8F0;
    font-size: 10px;
    font-weight: 700;
}
#scanProgress::chunk {
    background-color: #3182CE;
    border-radius: 2px;
}

#btnLogToggle {
    background-color: #1E293B;
    color: #94A3B8;
    border: 1px solid #334155;
    border-radius: 3px;
    padding: 3px 10px;
    font-size: 10px;
    font-weight: 700;
}
#btnLogToggle:hover {
    background-color: #334155;
    color: #FFFFFF;
}

#terminalLog {
    background-color: #090D16;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 4px;
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 11px;
    padding: 6px 8px;
    selection-background-color: #1E3A8A;
    selection-color: #FFFFFF;
}

#telemetryLogEdit {
    background-color: #090D16;
    color: #E2E8F0;
    border: 1px solid #1E293B;
    border-radius: 3px;
    font-family: "JetBrains Mono", "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 11px;
    padding: 4px 6px;
}

/* ── Scrollbars ────────────────────────────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
}
QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
}
QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── Page Canvas Backgrounds ───────────────────────────────── */
#pageScrollArea {
    background-color: #F0F2F5;
    border: none;
}
#dashContainer,
#cbomTab,
#detailTab {
    background-color: #F0F2F5;
}

/* ── Status Bar ────────────────────────────────────────────── */
QStatusBar {
    background-color: #FFFFFF;
    color: #64748B;
    border-top: 1px solid #CBD5E1;
    font-size: 11px;
    padding: 2px 8px;
}

/* ── Tooltips & Dialogs ────────────────────────────────────── */
QToolTip {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 1px solid #334155;
    border-radius: 3px;
    padding: 4px 8px;
    font-size: 11px;
}

QMessageBox {
    background-color: #FFFFFF;
}
